COMPOSE_PROFILES=full
# Modo dev com hot-reload (Vite HMR + tsx watch com polling): ver SETUP.md §2.5.
# Mude o profile para dev
# COMPOSE_PROFILES=dev
# Faça o build com o seguinte comando:
# docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build
POSTGRES_DB=flicker
POSTGRES_USER=flicker
POSTGRES_PASSWORD=flicker_dev_password
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_PASSWORD=flicker_redis_dev_password
GAME_SERVER_PORT=1234
GAME_SERVER_ID=
# Host anunciado no registro do Redis (consumido pelo lobby): o default
# `game-server` cobre dev/Docker Compose; em prod nativa use 127.0.0.1.
GAME_SERVER_ADVERTISE_HOST=game-server
GAME_SERVER_HEARTBEAT_INTERVAL_MS=5000
GAME_SERVER_HEARTBEAT_TTL_MS=15000
NGINX_PORT=8080
LOBBY_SERVER_PORT=3001
LOBBY_PUBLIC_URL=http://localhost:8080
# Endurecimento do WebSocket (issue #409).
# Origens exatas autorizadas a abrir o WS, separadas por vírgula (sem wildcard).
# Vazio/ausente deriva de LOBBY_PUBLIC_URL — fora de produção também libera
# http://localhost:5173 e http://127.0.0.1:5173.
# Ex.: https://app.exemplo.com,https://admin.exemplo.com
WS_ORIGENS_PERMITIDAS=
# Teto de bytes por mensagem WS (default 65536; faixa 1024..1048576).
WS_MAX_PAYLOAD_BYTES=65536
# Máximo de mensagens WS por conexão/Jogador não-bot (default 100).
WS_LIMITE_MENSAGENS=100
# Janela do limite geral de mensagens em ms (default 10000; faixa 100..600000).
WS_JANELA_LIMITE_MENSAGENS_MS=10000
JWT_SECRET=dev_jwt_secret_change_me
JWT_REFRESH_SECRET=dev_jwt_refresh_change_me
COOKIE_SECURE=false
SESSION_ACCESS_TTL_SECONDS=900
SESSION_REFRESH_TTL_SECONDS=604800
PARTIDA_TERMINADA_TTL_SEGUNDOS=3600
PARTIDA_NAO_INICIO_SEGUNDOS=90
PARTIDA_CHAT_HISTORICO_MAXIMO=50
# Nº de hops confiáveis antes do lobby; depende do encadeamento real:
# - dev/Docker Compose (cliente→nginx→lobby) = 1
# - produção nativa (cliente→proxy admin TLS→nginx edge:80→nginx app:8080→lobby) = 3
# (0 desliga o trust proxy).
TRUST_PROXY_HOPS=1
# Rate limit de login/cadastro: janela (s) e tetos por IP e por Cadastro (429 + Retry-After).
AUTH_RATE_LIMIT_JANELA_SEGUNDOS=900
AUTH_RATE_LIMIT_MAX_POR_IP=30
AUTH_RATE_LIMIT_MAX_POR_CADASTRO=10
LOBBY_RETORNO_CALLBACK_URL=http://localhost:3001/api/retorno
LOBBY_DESISTENCIA_CALLBACK_URL=http://localhost:3001/api/desistencia
NODE_ENV=development
PG_POOL_MAX=10
# Habilita o botão "+ Bot" no lobby (Anfitrião pode adicionar bots via UI).
# true por padrão em desenvolvimento (NODE_ENV != production).
# Defina como false para desabilitar mesmo em dev.
BOTS_HABILITADOS=true
