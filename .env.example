COMPOSE_PROFILES=full
# Modo dev com hot-reload (Vite HMR + tsx watch com polling): ver SETUP.md §2.5.
# Mude o profile para dev
# COMPOSE_PROFILES=dev
# Faça o build com o seguinte comando:
# docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build
POSTGRES_DB=flicker
POSTGRES_USER=flicker
POSTGRES_PASSWORD=flicker_dev_password
POSTGRES_PORT=5432
REDIS_PORT=6379
GAME_SERVER_PORT=1234
GAME_SERVER_ID=
# Host anunciado no registro do Redis (consumido pelo lobby): o default
# `game-server` cobre dev/Docker Compose; em prod nativa use 127.0.0.1.
GAME_SERVER_ADVERTISE_HOST=game-server
GAME_SERVER_HEARTBEAT_INTERVAL_MS=5000
GAME_SERVER_HEARTBEAT_TTL_MS=15000
NGINX_PORT=8080
LOBBY_SERVER_PORT=3001
LOBBY_PUBLIC_URL=http://localhost:8080
JWT_SECRET=dev_jwt_secret_change_me
JWT_REFRESH_SECRET=dev_jwt_refresh_change_me
COOKIE_SECURE=false
SESSION_ACCESS_TTL_SECONDS=900
SESSION_REFRESH_TTL_SECONDS=604800
PARTIDA_TERMINADA_TTL_SEGUNDOS=3600
LOBBY_RETORNO_CALLBACK_URL=http://localhost:3001/api/retorno
NODE_ENV=development
PG_POOL_MAX=10
