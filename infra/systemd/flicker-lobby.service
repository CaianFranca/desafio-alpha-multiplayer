[Unit]
Description=Flicker of Sanity — Lobby Server (API + WS de salas)
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=flicker
Group=flicker
WorkingDirectory=/opt/flicker/current
EnvironmentFile=/opt/flicker/env
Environment=NODE_ENV=production
# Artefato pré-compilado: o runtime é o JS emitido em dist/ (sem tsx).
Environment="NODE_OPTIONS=--max-old-space-size=64 --max-semi-space-size=8"
ExecStart=/usr/local/bin/node backend/lobby-server/dist/index.js
Restart=on-failure
RestartSec=5
MemoryMax=128M
MemorySwapMax=0

# Loopback-only: nada deste serviço conversa com fora da máquina.
IPAddressDeny=any
IPAddressAllow=localhost

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
