{
  "name": "flicker-of-sanity",
  "private": true,
  "workspaces": [
    "packages/*",
    "backend/game-server",
    "backend/lobby-server"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:audit": "node --test scripts/audit-dependencies.test.mjs",
    "dev": "npm run dev --workspace=@flicker/game-server",
    "test": "npm run test --workspace=@flicker/game-server",
    "test:all": "npm run test --workspaces --if-present",
    "bots": "tsx backend/lobby-server/scripts/bots-entrar-na-sala.ts",
    "bots:help": "tsx backend/lobby-server/scripts/bots-entrar-na-sala.ts --help"
  }
}
