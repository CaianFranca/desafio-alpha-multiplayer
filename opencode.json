{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "permission": {
        "bash": {
          "*": "ask",
          "npm run typecheck*": "allow",
          "npm run build*": "allow",
          "npx tsc*": "allow",
          "git branch*": "allow",
          "git rev-parse --abbrev-ref HEAD": "allow",
          "gh issue list*": "allow",
          "gh issue view*": "allow",
          "gh issue status*": "allow"
        }
      }
    },
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "npm run typecheck*": "allow",
          "npm run build*": "allow",
          "npx tsc*": "allow",
          "git branch*": "allow",
          "git rev-parse --abbrev-ref HEAD": "allow",
          "gh issue list*": "allow",
          "gh issue view*": "allow",
          "gh issue status*": "allow"
        }
      }
    }
  }
}
